# Horizon Travels — Server
# Copy to `.env` and adjust.

# HTTP
PORT=4000
NODE_ENV=development

# MongoDB Atlas (never commit the real URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/horizon_travels?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Search
SEARCH_PAGE_SIZE=20
SEARCH_CACHE_TTL_SECONDS=300

# Leaflet tile provider (OSM standard tiles; production should self-host tiles
# to respect the OSM tile usage policy)
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Self-hosted Nominatim (address geocoding) — the public service is never used
NOMINATIM_URL=http://localhost:8080
NOMINATIM_SEARCH_PATH=/search
NOMINATIM_REFERER=https://horizontravels.example
NOMINATIM_EMAIL=

# Best-effort enrichment from open sources (Wikimedia/Wikipedia)
ENRICHMENT_ENABLED=1
ENRICHMENT_USER_AGENT=HorizonTravels/1.0 (https://horizontravels.example)
ENRICHMENT_TIMEOUT_MS=4000
