# ─── Horizon Travels — self-hosted stack (docker compose) ──────────────
# Copy to `.env` and adjust. NEVER commit real secrets.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=horizon_travels

# API
API_PORT=4000
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:8081

# Web
WEB_PORT=8081

# Self-hosted Nominatim (address geocoding) — opt-in via --profile nominatim
NOMINATIM_PORT=8080
NOMINATIM_PBF_URL=https://download.geofabrik.de/asia/india-latest.osm.pbf
NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/asia/india-updates/
NOMINATIM_EMAIL=you@example.com

# Map tiles (OSM raster by default; production should self-host tiles)
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
