# Horizon Travels — canonical Node + MongoDB architecture
# Copy to .env. Never commit real credentials.
NODE_ENV=development
PORT=3002
MONGODB_URI=mongodb://localhost:27017/horizon_travels
MONGODB_DB=horizon_travels
JWT_SECRET=replace-with-at-least-48-random-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173

# Optional approved travel-provider credentials; server-side only.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Optional OAuth / transactional email. Related sign-in buttons remain hidden unless configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/auth/google/callback
SMTP_URL=
APP_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM=

# Cloudinary Media Storage
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
